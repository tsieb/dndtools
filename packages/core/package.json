		"test:smoke": "vitest run --config vitest.smoke.config.ts"
	},
	"devDependencies": {
		"@types/node": "^24.12.4",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8",
		"zod": "^4.5.4"
	}
}
