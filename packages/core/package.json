{
	"name": "@dndtools/core",
	"version": "0.3.3",
	"private": true,
	"type": "module",
	"description": "Processing Core: commands, reducers, permissions, queries, sync log shape.",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./testing": "./src/testing/index.ts"
	},
	"scripts": {
