{
  "name": "@dndtools/cloud-fns",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AWS Lambda handlers for dndtools cloud stacks (signaling, sync-api). Bundled with esbuild; imports @dndtools/core so server-side validation reuses the exact client security policy.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node build.mjs"
  },
  "dependencies": {
    "@dndtools/core": "workspace:*",
    "aws-jwt-verify": "^4.0.1"
  },
  "devDependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1092.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1092.0",
    "@aws-sdk/client-dynamodb": "^3.1092.0",
    "@aws-sdk/client-s3": "^3.1092.0",
    "@aws-sdk/client-secrets-manager": "^3.1092.0",
    "@aws-sdk/client-sesv2": "^3.1092.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.0"
  }
}
