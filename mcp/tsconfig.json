{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"outDir": "./dist",
		"rootDir": ".",
		"declaration": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"paths": {
			"$lib/*": ["../src/lib/*"]
		}
	},
	"include": ["./**/*.ts"],
	"exclude": ["dist", "node_modules"]
}
