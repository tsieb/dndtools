{
	"name": "dndtools",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter @dndtools/gm dev",
		"dev:react": "pnpm --filter @dndtools/gm-react dev",
		"build": "pnpm --filter @dndtools/core build && pnpm --filter @dndtools/gm build",
		"build:react": "pnpm --filter @dndtools/gm-react build",
		"build:react:demo": "pnpm --filter @dndtools/gm-react build:demo",
		"desktop:dev": "pnpm --filter @dndtools/gm-react desktop:dev",
		"desktop:build": "pnpm --filter @dndtools/gm-react desktop:build",
		"desktop:build:dir": "pnpm --filter @dndtools/gm-react desktop:build:dir",
		"preview": "pnpm --filter @dndtools/gm preview",
		"preview:react": "pnpm --filter @dndtools/gm-react preview",
		"preview:react:demo": "pnpm --filter @dndtools/gm-react preview:demo",
		"typecheck:react": "pnpm --filter @dndtools/gm-react typecheck",
		"verify:react": "node apps/gm-react/scripts/verify-routes.mjs && node apps/gm-react/scripts/verify-roundtrip.mjs && node apps/gm-react/scripts/verify-canvas.mjs && node apps/gm-react/scripts/verify-ui.mjs",
		"verify:react:routes": "node apps/gm-react/scripts/verify-routes.mjs",
		"verify:react:roundtrip": "node apps/gm-react/scripts/verify-roundtrip.mjs",
		"verify:react:canvas": "node apps/gm-react/scripts/verify-canvas.mjs",
		"verify:react:ui": "node apps/gm-react/scripts/verify-ui.mjs",
		"typecheck": "pnpm --filter @dndtools/core typecheck && pnpm --filter @dndtools/gm typecheck",
		"test": "pnpm --filter @dndtools/core test && pnpm --filter @dndtools/gm test && pnpm test:tooling",
		"test:tooling": "vitest run",
		"test:cloud": "vitest run --config vitest.cloud.config.ts",
		"test:critical": "pnpm --filter @dndtools/core test",
		"test:smoke": "pnpm lint:boundary && pnpm typecheck",
		"e2e": "pnpm --filter @dndtools/gm e2e",
		"lint": "eslint . && pnpm lint:boundary && pnpm a11y:contrast",
		"lint:boundary": "tsx scripts/boundary-lint.ts",
		"lint:fix": "eslint . --fix",
		"tokens:contrast": "tsx scripts/token-contrast-lint.ts",
		"a11y:contrast": "tsx scripts/a11y-nontext-contrast-lint.ts",
		"a11y:axe": "pnpm --filter @dndtools/gm exec playwright test tests/e2e/a11y-axe-gate.spec.ts --project=desktop-chromium --project=mobile-chromium",
		"a11y:report": "tsx scripts/a11y-axe-report.ts",
		"a11y:gate": "pnpm a11y:contrast && pnpm a11y:axe && pnpm a11y:report",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"gates": "tsx scripts/quality-gates.ts",
		"audit:repo": "vitest run tests/unit/ci-guardrails.test.ts",
		"check": "pnpm gates && pnpm lint:boundary && pnpm typecheck && pnpm test",
		"validate": "tsx scripts/validate/index.ts",
		"validate:fast": "tsx scripts/validate/index.ts --fast",
		"validate:live": "tsx scripts/validate/index.ts --live",
		"validate:full": "tsx scripts/validate/index.ts --full",
		"validate:list": "tsx scripts/validate/index.ts --list",
		"feature-audit": "tsx scripts/validate/feature-audit.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vitest": "^4.1.8",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	}
}
