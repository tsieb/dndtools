{
	"name": "dndtools",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test": "vitest run",
		"test:coverage": "vitest run src/lib/domain/export.test.ts --coverage.enabled true --coverage.include src/lib/domain/export.ts",
		"test:critical": "vitest run src/lib/platform/storage/index.test.ts src/lib/platform/storage/indexeddb-adapter.test.ts src/lib/types/session-state.test.ts src/lib/state/navigation.svelte.test.ts tests/unit/lint-boundary-rules.test.ts tests/unit/repo-boundary-audit.test.ts tests/unit/ci-guardrails.test.ts",
		"test:smoke": "tsx scripts/run-smoke.ts",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"audit:repo": "vitest run tests/unit/repo-boundary-audit.test.ts tests/unit/ci-guardrails.test.ts",
		"lint": "eslint . && pnpm lint:navigation && pnpm lint:tokens && pnpm audit:repo",
		"lint:tokens": "tsx scripts/token-compliance-lint.ts",
		"lint:circular": "tsx scripts/circular-dependency-lint.ts",
		"lint:fix": "eslint . --fix",
		"lint:navigation": "tsx scripts/nav-layer-lint.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"docs:validate": "tsx scripts/docs-validate.ts",
		"v2:workpack:generate": "tsx scripts/v2-workpack.ts generate",
		"v2:workpack:validate": "tsx scripts/v2-workpack.ts validate",
		"v2:workpack:status": "tsx scripts/v2-workpack.ts status",
		"v2:workpack:next": "tsx scripts/v2-workpack.ts next",
		"v2:workpack:set-status": "tsx scripts/v2-workpack.ts set-status",
		"v2:workpack:complete": "tsx scripts/v2-workpack.ts complete",
		"v2:prompt": "tsx scripts/v2-workpack.ts prompt",
		"v2:prompt:next": "tsx scripts/v2-workpack.ts prompt --next",
		"v2:dev": "pnpm --filter @dndtools/v2-app dev",
		"v2:build": "pnpm --filter @dndtools/v2-core build && pnpm --filter @dndtools/v2-app build",
		"v2:typecheck": "pnpm --filter @dndtools/v2-core typecheck && pnpm --filter @dndtools/v2-app typecheck",
		"v2:lint": "tsx scripts/v2-boundary-lint.ts",
		"v2:test": "pnpm --filter @dndtools/v2-core test && pnpm --filter @dndtools/v2-app test",
		"v2:e2e": "pnpm --filter @dndtools/v2-app e2e",
		"v2:check": "pnpm v2:workpack:validate && pnpm v2:lint && pnpm v2:typecheck && pnpm v2:test",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check": "pnpm lint && pnpm typecheck && pnpm test",
		"audit:quick": "tsx scripts/run-audit.ts quick",
		"audit:full": "tsx scripts/run-audit.ts full",
		"fixture:vault": "tsx scripts/generate-fixture-vault.ts",
		"perf:compare": "tsx scripts/compare-performance-baseline.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.3",
		"@capacitor/android": "^8.4.0",
		"@capacitor/cli": "^8.4.0",
		"@eslint/js": "^10.0.1",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.62.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/adm-zip": "^0.5.8",
		"@types/mdast": "^4.0.4",
		"@vitest/coverage-v8": "^4.1.8",
		"adm-zip": "^0.5.17",
		"electron": "^42.3.2",
		"electron-builder": "^26.8.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.6.0",
		"gray-matter": "^4.0.3",
		"jsdom": "^29.1.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.5.0",
		"tailwindcss": "^4.3.0",
		"tsup": "^8.5.1",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.8",
		"workbox-build": "^7.4.1",
		"zod": "^4.4.3"
	},
	"dependencies": {
		"@capacitor/core": "^8.4.0",
		"@capacitor/filesystem": "^8.1.2",
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.10.3",
		"@codemirror/lang-markdown": "^6.5.0",
		"@codemirror/language": "^6.12.3",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.43.0",
		"@lucide/svelte": "^1.17.0",
		"chokidar": "^5.0.0",
		"dexie": "^4.4.3",
		"electron-updater": "^6.8.3",
		"fflate": "^0.8.3",
		"minisearch": "^7.2.0",
		"nanoid": "^5.1.11",
		"rehype-sanitize": "^6.0.0",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0",
		"workbox-window": "^7.4.1",
		"yaml": "^2.9.0"
	}
}
