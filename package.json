{
	"name": "dndtools",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"main": "electron/dist/main.cjs",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"postinstall": "simple-git-hooks || true",
		"test": "vitest run",
		"test:critical": "vitest run src/lib/platform/storage/index.test.ts src/lib/platform/storage/indexeddb-adapter.test.ts src/lib/types/session-state.test.ts src/lib/state/navigation.svelte.test.ts tests/unit/lint-boundary-rules.test.ts",
		"test:smoke": "tsx scripts/run-smoke.ts",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"desktop:test": "pnpm desktop:build && playwright test -c playwright.desktop.config.ts",
		"desktop:test:critical": "pnpm desktop:build && playwright test -c playwright.desktop.config.ts --grep-invert @perf --grep-invert @memory --grep-invert @a11y",
		"desktop:test:a11y": "pnpm desktop:build && playwright test -c playwright.desktop.config.ts --grep @a11y",
		"desktop:test:perf": "pnpm desktop:build && playwright test -c playwright.desktop.config.ts --grep @perf",
		"desktop:test:memory": "pnpm desktop:build && playwright test -c playwright.desktop.config.ts --grep @memory",
		"test:e2e:desktop": "pnpm desktop:test",
		"test:e2e:desktop:critical": "pnpm desktop:test:critical",
		"test:e2e:desktop:a11y": "pnpm desktop:test:a11y",
		"test:e2e:desktop:perf": "pnpm desktop:test:perf",
		"test:e2e:desktop:memory": "pnpm desktop:test:memory",
		"lint": "eslint . && pnpm lint:navigation && pnpm lint:tokens",
		"lint:tokens": "tsx scripts/token-compliance-lint.ts",
		"lint:circular": "tsx scripts/circular-dependency-lint.ts",
		"lint:mcp-boundary": "tsx scripts/mcp-boundary-lint.ts",
		"lint:fix": "eslint . --fix",
		"lint:navigation": "tsx scripts/nav-layer-lint.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"docs:validate": "tsx scripts/docs-validate.ts",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check": "pnpm lint && pnpm typecheck && pnpm test",
		"audit:quick": "tsx scripts/run-audit.ts quick",
		"audit:full": "tsx scripts/run-audit.ts full",
		"metrics:capture": "tsx scripts/metrics-capture.ts",
		"metrics:compare": "tsx scripts/compare-baselines.ts",
		"mcp:dev": "tsx mcp/index.ts",
		"mcp:build": "tsup mcp/index.ts --format cjs --dts --outDir mcp/dist",
		"mcp:inspect": "npx @modelcontextprotocol/inspector tsx mcp/index.ts",
		"vault:verify": "tsx mcp/cli/vault-verify.ts",
		"desktop:build": "tsx scripts/desktop-build.ts",
		"desktop:package": "pnpm desktop:build && electron-builder --config electron-builder.yml --publish never",
		"desktop:package:win": "pnpm desktop:package -- --win nsis",
		"desktop:package:mac": "pnpm desktop:package -- --mac dmg zip",
		"desktop:package:linux": "pnpm desktop:package -- --linux AppImage deb",
		"desktop:run": "electron electron/dist/main.cjs",
		"desktop:start": "pnpm desktop:run",
		"desktop:smoke": "node scripts/desktop-smoke-test.mjs",
		"desktop": "pnpm desktop:build && pnpm desktop:run",
		"android:add": "cap add android",
		"android:sync": "pnpm build && cap sync android",
		"android:open": "cap open android",
		"android:assemble:release": "cd android && ./gradlew assembleRelease",
		"fixture:vault": "tsx scripts/generate-fixture-vault.ts",
		"perf:compare": "pnpm metrics:compare -- --only performance",
		"memory:profile": "tsx scripts/memory-profile.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.1",
		"@capacitor/android": "^8.1.0",
		"@capacitor/cli": "^8.1.0",
		"@eslint/js": "^10.0.1",
		"@modelcontextprotocol/sdk": "^1.26.0",
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/adm-zip": "^0.5.7",
		"@types/mdast": "^4.0.4",
		"@vitest/coverage-v8": "^4.0.18",
		"adm-zip": "^0.5.16",
		"electron": "^37.0.0",
		"electron-builder": "^25.1.8",
		"eslint": "^10.0.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.0",
		"fake-indexeddb": "^6.2.2",
		"globals": "^17.3.0",
		"gray-matter": "^4.0.3",
		"jsdom": "^28.0.0",
		"madge": "^8.0.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"simple-git-hooks": "^2.11.0",
		"svelte": "^5.49.2",
		"svelte-check": "^4.3.6",
		"tailwindcss": "^4.1.18",
		"tsup": "^8.5.1",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.55.0",
		"vite": "^7.3.1",
		"vite-plugin-pwa": "^1.1.0",
		"vitest": "^4.0.18",
		"zod": "^4.3.6"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm lint && pnpm format:check",
		"pre-push": "pnpm check"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"electron",
			"simple-git-hooks"
		]
	},
	"dependencies": {
		"@capacitor/core": "^8.1.0",
		"@capacitor/filesystem": "^8.1.2",
		"@codemirror/autocomplete": "^6.20.0",
		"@codemirror/commands": "^6.10.2",
		"@codemirror/lang-markdown": "^6.5.0",
		"@codemirror/language": "^6.12.1",
		"@codemirror/state": "^6.5.4",
		"@codemirror/view": "^6.39.13",
		"chokidar": "^5.0.0",
		"dexie": "^4.2.1",
		"electron-updater": "^6.7.0",
		"lucide-svelte": "^0.577.0",
		"minisearch": "^7.2.0",
		"nanoid": "^5.1.6",
		"rehype-sanitize": "^6.0.0",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0",
		"workbox-window": "^7.4.0",
		"yaml": "^2.8.2"
	}
}
