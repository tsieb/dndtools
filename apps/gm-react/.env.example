# Cloud coordinates for gm-react. All optional — absent means the app runs
# local-first with every cloud entry point hidden. Populate .env.local with real
# values via: node scripts/pull-cloud-env.mjs [stage]   (reads deployed SSM).
VITE_CLOUD_REGION=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_SIGNALING_WS_URL=
VITE_SYNC_API_URL=
