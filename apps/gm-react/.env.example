# Cloud coordinates for gm-react. All optional — absent means the app runs
# local-first with every cloud entry point hidden. Populate .env.local with real
# values via: node scripts/pull-cloud-env.mjs [stage]   (reads deployed SSM).
VITE_CLOUD_REGION=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_SIGNALING_WS_URL=
VITE_SYNC_API_URL=
VITE_APP_API_URL=
VITE_PUBLIC_APP_URL=
# Hosted AI calls fail closed unless their exact HTTPS origin is listed here. A Vite development
# build may additionally call an explicitly selected loopback runner (localhost/127.0.0.1/[::1]).
VITE_AI_ALLOWED_ORIGINS=https://api.anthropic.com https://api.openai.com
VITE_GOOGLE_CLIENT_ID=
