{
	"name": "@dndtools/gm-react",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"description": "Parallel React prototype of the DND Tools GM workspace — the design-package command-center kit, ported to a real Vite + React app wired to @dndtools/core. Isolated from the production SvelteKit app (@dndtools/gm).",
	"scripts": {
		"dev": "vite --port 5273",
		"build": "vite build",
		"build:demo": "vite build --outDir dist-demo --mode demo",
		"preview": "vite preview --port 4273",
		"preview:demo": "vite preview --outDir dist-demo --port 4274",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@dndtools/core": "workspace:*",
		"@fontsource/cinzel": "^5.2.8",
		"@fontsource/inter": "^5.2.8",
		"@fontsource/jetbrains-mono": "^5.2.8",
		"dexie": "^4.4.3",
		"lucide-react": "^0.460.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-router-dom": "^6.28.0"
	},
	"devDependencies": {
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"typescript": "^6.0.3",
		"vite": "^7.1.0"
	}
}
